NEXT_PUBLIC_SUPABASE_URL=https://poymbiesqofumdeubnze.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_URL=https://jvrecruiter.xyz

# Google Search Console verification meta token.
GOOGLE_SITE_VERIFICATION=

# Google Indexing API (server-only). Add these only after creating the
# Google Cloud service account and granting it ownership in Search Console.
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=


# Google Workspace OAuth for Gmail + Calendar integration.
# Configure these in Vercel as server-only variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a long random secret. Never expose it through NEXT_PUBLIC_*.
GOOGLE_TOKEN_ENCRYPTION_KEY=
